# Court Replay System - variaveis de ambiente
# Copie para .env e preencha os valores reais. NUNCA commite o .env.

# ---------------------------------------------------------------
# CAMERA (usado pelo agente Python, no notebook)
# ---------------------------------------------------------------
CAMERA_USER=admin
CAMERA_PASSWORD=sua_senha_aqui
CAMERA_RTSP_URL=rtsp://admin:sua_senha_aqui@192.168.3.100:8554/profile0

# ---------------------------------------------------------------
# SEGREDOS (precisam ser iguais no notebook e no servidor)
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------
NOTEBOOK_SHARED_SECRET=
APP_SECRET=

# ---------------------------------------------------------------
# SERVIDOR NODE.JS
# ---------------------------------------------------------------
NODE_PORT=3000
NODE_HOST=0.0.0.0

# Ligue apenas se houver um proxy reverso confiavel na frente.
# Afeta a identificacao do IP real para o rate limit.
TRUST_PROXY=false

# Ligue quando estiver servindo por HTTPS
COOKIE_SECURE=false

# ---------------------------------------------------------------
# PAINEL PUBLICO (alunos)
# O painel e aberto: os alunos so visualizam e baixam os proprios clips.
# Nao e possivel excluir clips pelo painel.
#
# DISABLE_PANEL=true tranca o painel: todo acesso mostra o aviso
# "site temporariamente indisponivel" (manutencao ou equipamento fora
# do lugar). O agente continua gravando. Reinicie o servidor apos mudar.
# ---------------------------------------------------------------
DISABLE_PANEL=false

# Opcional: exige login para acessar o painel (normalmente nao e usado).
AUTH_ENABLED=false

# ---------------------------------------------------------------
# ONDE ESTA O AGENTE PYTHON (visto pelo servidor Node)
#   mesma maquina (Docker): host.docker.internal
#   outro PC na LAN:         ex. 192.168.3.50
# ---------------------------------------------------------------
NOTEBOOK_HOST=127.0.0.1
NOTEBOOK_PORT=8765

# ---------------------------------------------------------------
# AGENTE PYTHON (no notebook)
# ---------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# true = testa sem camera, gerando video sintetico
AGENT_SIMULATE=false

# ---------------------------------------------------------------
# GERAL
# ---------------------------------------------------------------
TZ=America/Sao_Paulo
